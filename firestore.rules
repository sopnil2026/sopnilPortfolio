rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public contact form: visitors can submit messages.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'email', 'message', 'createdAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2000
        && request.resource.data.createdAt == request.time;

      // Only the portfolio owner can read or delete submitted messages.
      allow read, delete: if request.auth != null
        && request.auth.token.email == 'sopnilprodhan13@gmail.com';

      allow update: if false;
    }

    // Portfolio data is public to read, but only the owner may create/update it.
    match /siteContent/portfolio {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.token.email == 'sopnilprodhan13@gmail.com'
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
